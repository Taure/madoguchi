{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {cowboy, "2.15.0"}
]}.

{project_plugins, [
    erlfmt,
    rebar3_ex_doc,
    rebar3_lint,
    rebar3_hank,
    {rebar3_audit, {git, "https://github.com/Taure/rebar3_audit.git", {branch, "main"}}},
    {rebar3_sbom,
        {git, "https://github.com/Taure/rebar3_sbom.git", {branch, "feat/include-otp-components"}}},
    covertool
]}.

{hex, [{doc, ex_doc}]}.

{erlfmt, [write]}.

{hank, [
    {ignore, [
        "test/**"
    ]}
]}.

{dialyzer, [
    {warnings, [error_handling, unmatched_returns, unknown]},
    {plt_apps, all_deps}
]}.

{xref_checks, [undefined_function_calls, undefined_functions]}.

{ct_opts, [{dir, "test"}]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{cover_enabled, true}.

{ex_doc, [
    {extras, [
        <<"README.md">>,
        <<"SECURITY.md">>,
        <<"docs/getting-started.md">>,
        <<"docs/adr/0001-mcp-server-core.md">>,
        <<"docs/adr/0002-http-transport-security.md">>,
        <<"docs/adr/0003-stdio-transport.md">>,
        <<"docs/adr/0004-resources.md">>,
        <<"docs/adr/0005-prompts.md">>,
        <<"docs/adr/0006-tool-enrichments.md">>,
        <<"docs/adr/0007-protocol-2025-11-25.md">>
    ]},
    {main, <<"readme">>},
    {proglang, erlang},
    {source_url, <<"https://github.com/Taure/madoguchi">>}
]}.
